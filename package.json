{
  "name": "@agentience/react-design-systems-mcp",
  "version": "1.0.7",
  "description": "Model Context Protocol (MCP) server that provides comprehensive information about design systems created for React, currently focusing on AWS Cloudscape Design System",
  "main": "dist/index.js",
  "bin": {
    "react-design-systems-mcp": "./dist/server.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:sse": "PORT=3001 nodemon --exec ts-node src/server.ts --transport sse",
    "build": "pnpm run clean && pnpm run prepare && pnpm run update-links && pnpm run postbuild",
    "prebuild": "pnpm run clean",
    "postbuild": "node -e \"require('fs').cpSync('src/components/data', 'dist/components/data', {recursive: true}); require('fs').chmodSync('dist/server.js', '755');\"",
    "prepare": "tsc -p tsconfig.build.json",
    "update-links": "python3 scripts/update-markdown-links.py",
    "update-links:dry-run": "python3 scripts/update-markdown-links.py --dry-run",
    "update-links:verbose": "python3 scripts/update-markdown-links.py --verbose",
    "test": "vitest run",
    "test:unit": "vitest -c vitest.unit.config.ts run",
    "test:e2e": "vitest -c vitest.e2e.config.ts run",
    "test:tools": "vitest -c vitest.e2e.config.ts run tests/e2e/tools.test.ts",
    "test:resources": "vitest -c vitest.e2e.config.ts run tests/e2e/resources.test.ts",
    "test:roo": "vitest -c vitest.e2e.config.ts run tests/e2e/roo-integration.test.ts",
    "test:components": "vitest -c vitest.e2e.config.ts run tests/e2e/component-details.test.ts",
    "test:search": "vitest -c vitest.unit.config.ts run tests/unit/search-engine.test.ts",
    "test:ci": "CI=true SKIP_LONG_RUNNING_TESTS=true vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run test:ci"
  },
  "keywords": [
    "mcp",
    "react",
    "design-system",
    "design-systems",
    "cloudscape",
    "components",
    "ui"
  ],
  "author": "",
  "license": "",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "fastmcp": "^1.22.4",
    "js-yaml": "^4.1.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.19",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.3",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
